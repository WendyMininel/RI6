{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./",
    "types": ["node"]
  },
  "include": ["*.ts", "src/calculadora.ts", "src/mensagens.ts", "src/operacao.ts", "src/soma.ts"],
  "exclude": ["node_modules", "dist"]
}